<?xml version="1.0" encoding="utf-8"?>
<!--
  솔루션별 MSI 공통 템플릿 (WiX Toolset v3.14)
  직접 고치지 말고 solutions\<ID>\solution.ini 를 고친 뒤 build-msi.bat 로 빌드하세요.
  build-msi.ps1 이 obj\<ID>\vars.wxi 에 아래 변수를 만들어 넣습니다.

    SolutionId, ProductName, Manufacturer, ProductVersion, UpgradeCode,
    CompanyFolder, InstallFolderName, ShortcutName, ShortcutDescription,
    RegKey, Codepage, Language, DesktopShortcut(1/0),
    UpdaterExe, UpdaterIni, IconFile, LogoFile(없으면 빈 값)

  MSI 에는 런처만 들어갑니다 (Updater.exe, updater.ini, 아이콘, 바로가기).
  실제 프로그램 파일은 처음 실행할 때 Updater.exe 가 서버에서 받아옵니다.
-->
<?include $(var.VarsFile) ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="$(var.Language)"
           Codepage="$(var.Codepage)"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <!-- InstallerVersion 500: 폴더 권한(PermissionEx/SDDL) 에 필요. Windows 7 이상 -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             SummaryCodepage="$(var.Codepage)" Languages="$(var.Language)"
             Description="$(var.ProductName) 설치" Comments="$(var.SolutionId)" />

    <!-- 같은 솔루션의 다른 버전 MSI 를 실행하면 자동으로 교체 (UpgradeCode 가 솔루션마다 다름) -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="이미 더 새로운 버전의 [ProductName] 설치 프로그램이 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="솔루션 ID: $(var.SolutionId)" />

    <!-- 다시 설치/업그레이드할 때 지난번 설치 폴더를 그대로 사용 -->
    <Property Id="PREVINSTALLFOLDER">
      <RegistrySearch Id="FindPrevInstallFolder" Root="HKLM" Key="$(var.RegKey)"
                      Name="InstallFolder" Type="raw" />
    </Property>
    <CustomAction Id="UsePrevInstallFolder" Property="INSTALLFOLDER" Value="[PREVINSTALLFOLDER]" />
    <InstallExecuteSequence>
      <Custom Action="UsePrevInstallFolder" Before="CostFinalize">PREVINSTALLFOLDER AND NOT Installed</Custom>
    </InstallExecuteSequence>
    <InstallUISequence>
      <Custom Action="UsePrevInstallFolder" Before="CostFinalize">PREVINSTALLFOLDER AND NOT Installed</Custom>
    </InstallUISequence>

    <!-- 폴더 구조: Program Files (x86)\<회사>\<솔루션>  (설치 때 INSTALLFOLDER=경로 로 바꿀 수 있음) -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="CompanyFolder" Name="$(var.CompanyFolder)">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MenuFolder" Name="$(var.CompanyFolder)" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <!--
        런처는 설치 폴더 안에서 파일을 직접 교체합니다 (bin\.update, 프로그램 파일, Updater.exe 자신).
        Program Files 는 기본적으로 일반 사용자가 쓸 수 없으므로 이 폴더에만 Users 수정 권한을 줍니다.
        SDDL 은 SID 기반이라 한글 Windows 에서도 그룹 이름 문제가 없습니다.
          SY=SYSTEM, BA=Administrators: 모든 권한 / BU=Users: 수정(삭제 포함), 하위 폴더·파일 상속
      -->
      <Component Id="InstallFolderAcl" Guid="*">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;BU)" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="$(var.RegKey)" Name="InstallFolder" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="$(var.RegKey)" Name="SolutionId" Type="string"
                       Value="$(var.SolutionId)" />
      </Component>

      <Component Id="UpdaterExe" Guid="*">
        <File Id="UpdaterExe" Name="Updater.exe" Source="$(var.UpdaterExe)" KeyPath="yes" />
      </Component>

      <!-- updater.ini: 서버 주소·솔루션 ID·서명 키. 설치 후 PC 에서 고친 값은 복구(repair) 때 덮어쓰지 않음 -->
      <Component Id="UpdaterIni" Guid="*">
        <File Id="UpdaterIni" Name="updater.ini" Source="$(var.UpdaterIni)" KeyPath="yes" />
      </Component>

<?if $(var.LogoFile) != "" ?>
      <Component Id="LogoPng" Guid="*">
        <File Id="LogoPng" Name="logo.png" Source="$(var.LogoFile)" KeyPath="yes" />
      </Component>
<?endif?>
    </DirectoryRef>

    <!-- 시작 메뉴 바로가기 (모든 사용자) -->
    <DirectoryRef Id="MenuFolder">
      <Component Id="MenuShortcut" Guid="*">
        <Shortcut Id="MenuShortcut" Name="$(var.ShortcutName)" Description="$(var.ShortcutDescription)"
                  Target="[INSTALLFOLDER]Updater.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon.ico" IconIndex="0" />
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="$(var.RegKey)" Name="MenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

<?if $(var.DesktopShortcut) = "1" ?>
    <!-- 바탕화면 바로가기 (모든 사용자 바탕화면) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut" Name="$(var.ShortcutName)" Description="$(var.ShortcutDescription)"
                  Target="[INSTALLFOLDER]Updater.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="$(var.RegKey)" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
<?endif?>

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="InstallFolderAcl" />
      <ComponentRef Id="UpdaterExe" />
      <ComponentRef Id="UpdaterIni" />
<?if $(var.LogoFile) != "" ?>
      <ComponentRef Id="LogoPng" />
<?endif?>
      <ComponentRef Id="MenuShortcut" />
<?if $(var.DesktopShortcut) = "1" ?>
      <ComponentRef Id="DesktopShortcut" />
<?endif?>
    </Feature>
  </Product>
</Wix>
